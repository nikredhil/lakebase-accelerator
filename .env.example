# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Loaded by accelerator/config.py via python-dotenv.
# ---------------------------------------------------------------------------

# --- Claude (language detection + code conversion) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Databricks workspace (Terraform provider + Databricks Connect) ---
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Which cloud the workspace runs on: aws | azure | gcp  (picks default node type)
CLOUD=aws

# --- Cluster sizing (Manas: 1-2 nodes max, small data) ---
MAX_WORKERS=2
SPARK_VERSION=15.4.x-scala2.12

# --- Execution backend for the candidate (converted) code ---
# databricks  -> run on the workspace via Databricks Connect (needs databricks-connect)
# local       -> run on local pyspark (dry-run; needs Java + pyspark)
CANDIDATE_BACKEND=local

# --- GitHub (PR creation test; use VS Code + your personal GitHub) ---
GITHUB_REPO=your-username/lakebase-accelerator   # owner/repo for PRs
PR_BASE_BRANCH=main
