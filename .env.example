# Copy to .env (gitignored). Credentials for the accelerator to talk to Databricks.
DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
CLOUD=azure          # aws | azure | gcp  (selects default node type)
MAX_WORKERS=2
SPARK_VERSION=15.4.x-scala2.12
# Optional overrides:
# USE_SPOT=true
# SINGLE_NODE=false
# AUTOTERMINATION_MINUTES=20
# NODE_TYPE_ID=          # override per-cloud default
# CREATE_SCHEMA=false
# CATALOG_NAME=main
# LAKEBASE_CUSTOM_TAGS=team=data,cost_center=1234
